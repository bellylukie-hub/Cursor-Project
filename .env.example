# Copy to .env and customize before: docker compose up -d

# Required — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Server
PORT=3001
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*

# First deploy only: true loads demo trips if database is empty. ALWAYS false in production.
RUN_SEED=false

# Password applied to all seeded users (super_admin, ops_manager, etc.)
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
